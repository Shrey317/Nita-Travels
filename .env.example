# Neon PostgreSQL pooled connection string (used at runtime)
DATABASE_URL=

# Neon PostgreSQL direct connection string (used for migrations only)
DIRECT_URL=

# Full URL of the deployed application (e.g. https://nita-fleet.vercel.app)
NEXTAUTH_URL=

# Random JWT signing secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Vercel Blob storage token (Storage tab -> Blob -> create store -> copy token)
BLOB_READ_WRITE_TOKEN=
