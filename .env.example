# Neon PostgreSQL pooled connection string (used at runtime)
DATABASE_URL=

# Neon PostgreSQL direct connection string (used for migrations only)
DIRECT_URL=

# Full URL of the deployed application (e.g. https://nita-fleet.vercel.app)
NEXTAUTH_URL=

# Random JWT signing secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Vercel Blob storage token (Storage tab -> Blob -> create store -> copy token)
BLOB_READ_WRITE_TOKEN=

# Planned Gmail password-reset delivery (not active until recovery is implemented)
GMAIL_USER=drash1731@gmail.com
# Configure directly in encrypted hosting settings; never commit a real value.
GMAIL_APP_PASSWORD=

# Dedicated readiness monitor credential; generate at least 32 random characters.
MONITORING_SECRET=
# Error monitoring stays disabled until a Sentry project is configured.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
