// Nita Travels Fleet Management System — Prisma Schema
//
// Critical schema rules (see SRS Section 11):
// - All ZAR amounts stored as integer cents (Int). Float/Decimal are prohibited for currency.
// - Transaction.vehicleId is nullable: null = no vehicle (e.g. loan repayments, excluded from
//   vehicle groupings), "ALLCR" = fleet-wide entry (counts toward fleet totals, excluded from
//   per-vehicle P&L), "CR01"-"CR09" = normal vehicle entries.
// - Service status is NEVER stored — always computed server-side at read time (see lib/service.ts).
// - nextSvcKm is NEVER stored — always computed as mileageKm + vehicle.serviceIntervalKm.
// - VehicleNote is delete-and-re-enter only; there is no update path in the API.
// - Transaction.vehicleId and VehicleNote.vehicleId are deliberately NOT foreign keys, even
//   though most of their values are real Vehicle ids — "ALLCR" is a valid value for both but
//   isn't a real Vehicle row, and Postgres foreign keys can't accept "either a real row or this
//   one specific sentinel string." Real-vehicle referential integrity is enforced in the
//   application layer instead (Zod schemas + lib/db/*.ts), the same layer that already enforces
//   the ALLCR/null cases a hard FK could never express anyway.
//
// photoUrls[] fields (added beyond the original spec, per product decision): each stores zero or
// more Vercel Blob URLs. Attaching a photo is optional everywhere it appears. These are plain
// string arrays rather than a separate Photo model because notes/transactions/mileage entries are
// themselves immutable-after-creation (notes) or edited as a whole (transactions, mileage) — a
// join table would add a CRUD surface with no matching business rule to justify it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vehicle {
  id                    String         @id // CR01–CR09, fixed — never auto-generated
  make                  String
  model                 String
  registration          String
  registration2         String?
  transmission          String // "Manual" | "Auto"
  purchaseDate          DateTime       @db.Date
  purchasePriceCents    Int
  mileageAtPurchaseKm   Int
  currentMileageKm      Int            @default(0)
  warranty              String?
  serviceIntervalKm     Int            @default(20000)
  targetEmiCents        Int            @default(0)
  emiMonthsTotal        Int            @default(0)
  emiMonthsPaid         Int            @default(0)
  insurer               String?
  policyNumber          String?
  monthlyPremiumCents   Int            @default(0)
  insurancePeriodMonths Int            @default(0)
  insuranceEndDate      DateTime?      @db.Date
  active                Boolean        @default(true)
  mileageEntries        MileageEntry[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  @@index([active])
}

model Transaction {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  // "CR01"-"CR09" | "ALLCR" | null — deliberately NOT a foreign key. ALLCR is a valid value
  // here but is not a real Vehicle row, so a hard FK relation would reject every fleet-wide
  // entry. Referential integrity for the real-vehicle case is enforced in the application layer
  // (Zod schemas + lib/db/transactions.ts), the same way null and ALLCR already are.
  vehicleId       String?
  category        Category
  incomeZarCents  Int       @default(0)
  expenseZarCents Int       @default(0)
  notes           String?
  mileageKm       Int? // Service rows only: mileage at time of service
  photoUrls       String[]  @default([]) // receipt / invoice photos, optional
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([vehicleId])
  @@index([date])
  @@index([category])
}

enum Category {
  Service
  Fuel
  Tyres
  BrakePads
  Repairs
  License
  Maintenance
  Other
  UberFees
  Income
}

model MileageEntry {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
  previousMileageKm Int
  currentMileageKm  Int
  distanceDrivenKm  Int // enforced server-side: currentMileageKm - previousMileageKm
  isoWeek           Int // 1-53
  isoYear           Int
  weeklyLimitKm     Int      @default(2000)
  overLimitByKm     Int? // null if within limit; positive integer if over
  photoUrls         String[] @default([]) // odometer photo, optional
  createdAt         DateTime @default(now())

  @@index([vehicleId])
  @@index([isoYear, isoWeek])
}

model VehicleNote {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  // "CR01"-"CR09" | "ALLCR" | null — same reasoning as Transaction.vehicleId above: not a
  // foreign key, since ALLCR is a valid value but not a real Vehicle row.
  vehicleId String?
  note      String // free text, no categories, no character limit
  photoUrls String[] @default([]) // optional photos attached at entry time
  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([date])
}

model RateLimit {
  key       String   @id
  points    Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
